---
import { getCollectionRevChron } from "src/content.config";
import BaseLayout from "../layouts/BaseLayout.astro";
import Collection from "@components/Collection.astro";
const teams = await getCollectionRevChron("teams");
const writing = await getCollectionRevChron("writing");
const lists = await getCollectionRevChron("lists");
const projects = await getCollectionRevChron("projects");
const travel = await getCollectionRevChron("travel");
const talks = await getCollectionRevChron("talks");
---

<BaseLayout title="Dan Schlosser" heroStyle="normal">
  <Collection title="Teams" url="/teams" entries={teams} mini />
  <Collection title="Travel" url="/travel" entries={travel} feature="first" />
  <Collection
    title="Writing"
    url="/writing"
    entries={writing}
    feature="first"
  />
  <Collection title="Projects" url="/projects" entries={projects} mini />
  <Collection title="Lists" url="/lists" entries={lists} mini />
  <Collection title="Talks" url="/talks" entries={talks} mini />
</BaseLayout>
