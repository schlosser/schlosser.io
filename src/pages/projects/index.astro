---
import CollectionLayout from "@layouts/CollectionLayout.astro";
import PostPreview from "@components/PostPreview.astro";
import { getCollectionRevChron } from "src/content.config";

const posts = await getCollectionRevChron("projects");
---

<CollectionLayout title="Projects" collection="projects">
  <div class="boxes">
    {posts.map((post) => <PostPreview page={post} />)}
  </div>
</CollectionLayout>
