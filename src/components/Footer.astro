---
interface Props {
  redirectTo?: string;
}

const { redirectTo } = Astro.props;
import { SOCIAL_LINKS } from "../consts";
---

<div class="content">
  <section>
    <hr />
  </section>
</div>
<footer>
  <div class="content">
    <div class="footer-wrapper">
      <div class="about-wrapper">
        {
          redirectTo ? (
            <p>&nbsp;</p>
          ) : (
            <h2>
              <a href="/">
                Dan
                <br />
                Schlosser
              </a>
            </h2>
          )
        }
      </div>
      <div class="links-wrapper">
        <div class="pages">
          <h3>
            <a href="/teams/">Teams</a> &middot;
            <a href="/travel/">Travel</a> &middot;
            <a href="/writing/">Writing</a> &middot;
            <a href="/projects/">Projects</a> &middot;
            <a href="/lists/">Lists</a> &middot;
            <a href="/talks/">Talks</a>
          </h3>
        </div>
        <div class="links">
          <h3>
            {
              SOCIAL_LINKS.map(({ title, url }, idx) => (
                <>
                  {idx !== 0 && <>&middot; </>}
                  <a href={url}>{title}</a>
                </>
              ))
            }
          </h3>
        </div>
      </div>
    </div>
  </div>
</footer>
