---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../consts";

interface Props {
  title?: string;
  collection?: string;
  redirectTo?: string;
  heroStyle?: "full-bleed" | "large" | "normal" | "none";
}

const { title, collection, redirectTo, heroStyle } = Astro.props;
---

<header>
  <div class="content">
    {
      redirectTo ? (
        <h1>&nbsp;</h1>
      ) : (
        <>
          <p class="path">
            <span class="component">
              <a href="/">Dan Schlosser</a>
            </span>
            {collection && title && (
              <>
                <span class="slash">/</span>
                <span class="component capitalize">
                  <a href={`/${collection}/`}>{collection}</a>
                </span>
              </>
            )}
            <span class="slash">/</span>
            <br class="mobile-only" />
          </p>
          {heroStyle !== "full-bleed" &&
            (title ? (
              <h1>{title}</h1>
            ) : collection ? (
              <h1>{collection}</h1>
            ) : null)}
        </>
      )
    }
  </div>
</header>
